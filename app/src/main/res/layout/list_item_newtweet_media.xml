<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="100dp">

    <ImageView
        android:id="@+id/media"
        android:layout_width="wrap_content"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/content_desc_upload_image"
        android:src="@drawable/icon_loading" />

    <TextView
        android:id="@+id/mediaType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="@color/selectedMediaTextBackground"
        android:paddingHorizontal="2dp"
        android:textColor="@color/selectedMediaText"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/mediaSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:background="@color/selectedMediaTextBackground"
        android:paddingHorizontal="2dp"
        android:textColor="@color/selectedMediaText"
        android:textSize="12sp" />

</FrameLayout>
